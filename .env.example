# Tushare Pro 个人/机构 Token（仅配置在运行环境或 CI Secret，切勿提交到仓库）
TUSHARE_TOKEN=

# 发布模式：
# - compliance_notice : 仅发布合规说明与隔离演示算例（无公开展示授权时的默认安全模式）
# - authorized_real   : 仅在已取得合法公开展示授权后开启，将真实榜单快照发布到公开目录
A15_PUBLISH_MODE=compliance_notice

# 可选：BaoStock 单次请求间隔（秒）与重试次数
BAOSTOCK_SLEEP_SEC=0.12
BAOSTOCK_MAX_RETRIES=3
